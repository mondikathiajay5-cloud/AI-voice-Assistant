# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Supabase (Postgres) ---
# Create a free project at https://supabase.com, then find these under
# Project Settings > API and Project Settings > Database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (free tier) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- OpenRouter (alternative) ---
# You can also use OpenRouter instead of Gemini.
# Get a key at https://openrouter.ai and set OPENROUTER_API_KEY / OPENROUTER_MODEL.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:freeY

# --- Escalation behaviour ---
# Intent-classification confidence below this triggers escalation instead
# of a direct answer.
ESCALATION_CONFIDENCE_THRESHOLD=0.55
